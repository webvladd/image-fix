{
  "name": "image-fix-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "node --require ./scripts/no-sass-legacy-warning.cjs node_modules/vite/bin/vite.js",
    "dev:server": "tsx watch server/server.ts",
    "build": "tsc -p tsconfig.json && node --require ./scripts/no-sass-legacy-warning.cjs node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/no-sass-legacy-warning.cjs node_modules/vite/bin/vite.js preview",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "start:server": "tsx server/server.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.80.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard-scss": "^12.0.0",
    "stylelint-order": "^6.0.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
